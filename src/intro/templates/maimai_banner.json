{
  "canvas": {
    "width": 1080,
    "height": 1080,
    "fps": 60,
    "durationFrames": 1
  },
  "card": {
    "_comment": "MusicBase 420x636 native from prefab. heightRatio 0.78 + topMargin 0.16 gives enough room above for the MBase_Tab (which extends ~104 native px above card top, i.e. ~138 output px at this scale).",
    "nativeWidth": 420,
    "nativeHeight": 636,
    "heightRatio": 0.78,
    "topMargin": 0.16
  },
  "assetsRoot": "qrc:/intro/assets/trackstart",
  "lvAtlasRoot": "qrc:/intro/assets/lv_atlas",
  "fontsRoot": "qrc:/intro/assets/fonts",
  "transparentBackground": true,
  "lvAtlas": {
    "_comment": "Per-difficulty digit/symbol atlases. Each atlas is 192x240, 4x4 grid of 48x60 cells. Cell index 0-9 = digit, 10='+', 11='-', 12=',', 13='·', 14='LV' label.",
    "BASIC":    "UI_NUM_MLevel_01.png",
    "ADVANCED": "UI_NUM_MLevel_02.png",
    "EXPERT":   "UI_NUM_MLevel_03.png",
    "MASTER":   "UI_NUM_MLevel_04.png",
    "ReMASTER": "UI_NUM_MLevel_05.png",
    "cellW": 48,
    "cellH": 60,
    "gridCols": 4
  },
  "fonts": {
    "_comment": "Free public substitutes for SEGA proprietary fonts, both from the M PLUS family (paired by design). NewRodin EB (display) -> M PLUS 1p Black; MaruGothic DB (body) -> M PLUS Rounded 1c Bold. Qt's font fallback handles non-JP CJK via the system font (e.g. Yu Gothic UI / Microsoft YaHei).",
    "display": "MPLUS1p-Black.ttf",
    "body": "MPLUSRounded1c-Bold.ttf"
  },
  "assets": {
    "frame": {
      "BASIC":    "UI_TST_MBase_BSC.png",
      "ADVANCED": "UI_TST_MBase_ADV.png",
      "EXPERT":   "UI_TST_MBase_EXP.png",
      "MASTER":   "UI_TST_MBase_MST.png",
      "ReMASTER": "UI_TST_MBase_MST_Re.png"
    },
    "tab": {
      "BASIC":    "UI_TST_MBase_BSC_Tab.png",
      "ADVANCED": "UI_TST_MBase_ADV_Tab.png",
      "EXPERT":   "UI_TST_MBase_EXP_Tab.png",
      "MASTER":   "UI_TST_MBase_MST_Tab.png",
      "ReMASTER": "UI_TST_MBase_MST_Re_Tab.png"
    },
    "lvPill": {
      "BASIC":    "UI_TST_MBase_LV_BSC.png",
      "ADVANCED": "UI_TST_MBase_LV_ADV.png",
      "EXPERT":   "UI_TST_MBase_LV_EXP.png",
