# CTest scratch + local build/audit artifacts — never version-controlled.
Testing/
build_artifacts/

# Keep the public docs tree explicit and leave local/private notes untracked.
docs/*
!docs/README.md
!docs/specs/
!docs/specs/**
!docs/tests/
!docs/tests/**
!docs/ops/
!docs/ops/**
!docs/archive/
!docs/archive/**
!docs/audit/
!docs/audit/**
docs/_private/

# Local ffmpeg binaries should not be versioned.
third_party/ffmpeg/**/ffmpeg
third_party/ffmpeg/**/ffmpeg.exe
third_party/ffmpeg/**/ffprobe
third_party/ffmpeg/**/ffprobe.exe

# FFmpeg dev SDK (headers + import libs + runtime DLLs) for the QtAVPlayer
# preview decode backend. Provisioned by scripts/ensure-windows-ffmpeg-dev.ps1,
# never committed — the .dll are caught by the third_party/**/*.dll rule below,
# this also keeps the headers + .lib import libraries out of version control.
third_party/ffmpeg/windows/dev/
third_party/ffmpeg/windows/dev.full.bak/
third_party/ffmpeg/macos/dev/
third_party/ffmpeg/linux/dev/

# libmpv vendoring — keep headers + import lib + .def under VC, ignore
# the downloaded archive and any regenerated .exp file.
third_party/mpv/**/*.7z
third_party/mpv/**/*.exp

# Third-party binary blobs — never track DLLs/EXEs/SOs/dylibs anywhere
# under third_party/. The libmpv-2.dll incident (112 MB blob shipped to
# 96 commits, blocked by GitHub's 100 MB push limit) showed that
# accidentally vendoring a runtime binary can require painful history
# rewrites to fix. Build/runtime binaries should be sourced via a
# package manager / download script, never committed.
third_party/**/*.dll
third_party/**/*.exe
third_party/**/*.so
third_party/**/*.so.*
third_party/**/*.dylib
third_party/**/*.a

# scripts whitelist: ignore all by default, allow only release/infra scripts.
scripts/*
!scripts/Start_MiaCode_Debug.bat
!scripts/Start_MiaCode_Legacy_QML.bat
!scripts/Start_MiaCode_DiagBypass.bat
!scripts/Start_MiaCode_SkipBoth.bat
!scripts/Start_MiaCode_SkipDiagD3D11.bat
!scripts/Start_MiaCode_QtPluginDiag.bat
!scripts/Start_MiaCode_ExportNoPboReadback.bat
!scripts/Start_MiaCode_SoftwareVideoDecode.bat
!scripts/build-macos.sh
!scripts/build-win.ps1
!scripts/compare-export-encode-profiles.ps1
!scripts/ensure-macos-ffmpeg.sh
!scripts/ensure-windows-ffmpeg.ps1
!scripts/ensure-windows-ffmpeg-dev.ps1
# FFmpeg decode-only trim toolchain (build scripts + allowlist config + docs).
!scripts/ffmpeg-trim
!scripts/ffmpeg-trim/**
# ...but never the per-run report the survey .bat generates next to itself.
scripts/ffmpeg-trim/ffmpeg-codec-survey.txt
!scripts/export_and_analyze_duplicates.py
# HUD font subsetting toolchain (script + 通用规范汉字表 charset + docs).
!scripts/subset_hud_font.py
!scripts/tongyong_guifan.txt
!scripts/README_font_subset.md
!scripts/gen_same_lane_v_slides.py
!scripts/package-mac.sh
!scripts/package-win.ps1
!scripts/README.md
!scripts/README_EN.md
# Ignore local Claude config, but version-control the repo-guide skill.
.claude/*
!.claude/skills/

# Python bytecode caches (e.g. tools/lvcard_gen).
__pycache__/
*.pyc

# Throwaway slide-arrow-count analysis script + its generated CSV (repo root).
/slide_arrow_count.py
/slide_arrow_count.csv
