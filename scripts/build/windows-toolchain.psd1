# Single source of truth for the Windows build + packaging chain.
#
# build-win.ps1, package-win.ps1 and verify-win-package.ps1 all read this file
# so the Qt version, the toolchain definitions and the package contents
# contract live in one place. Edit here, not in the scripts.
@{
    Qt = @{
        Version = '6.11.1'
        Modules = @('qtmultimedia', 'qtshadertools')
        # Probed in order before any download. {version} and {archdir} expand
        # per selected toolchain. A candidate must contain lib\cmake\Qt6 and
        # bin\windeployqt.exe to be accepted.
        RootCandidates = @(
            'C:\Qt\{version}\{archdir}',
            '.qt\{version}\{archdir}',
            '$env:QT_ROOT_DIR',
            '$env:Qt6_DIR'
        )
    }

    Toolchains = @{
        mingw = @{
            # Target architecture this toolchain produces. Selects the BASS
            # runtime, the FFmpeg dev SDK and the package name suffix.
            Arch        = 'x64'
            # aqt arch name (only used when Qt has to be downloaded)
            AqtArch     = 'win64_mingw'
            # Qt download repository host tree (windows_x86 / windows_arm64).
            QtHostPlatform = 'windows_x86'
            # directory name under <qt-prefix>\<version>\
            ArchDir     = 'mingw_64'
            Generator   = 'Ninja'
            # '' => the generator's default target platform.
            GeneratorPlatform = ''
            BuildType   = 'Release'
            # Compiler root; '' means "resolve from PATH".
            CompilerRoot = 'C:\Qt\Tools\mingw1310_64'
            CCompiler   = 'bin\gcc.exe'
            CxxCompiler = 'bin\g++.exe'
            # C++ runtime the package has to carry app-locally.
            # C++ runtime plus the D3D shader compiler the MinGW build links
            # against. windeployqt stages D3Dcompiler_47.dll for MinGW; the MSVC
            # build neither imports it nor gets it deployed (windeployqt skips it
            # as a system library), so it belongs to this toolchain.
            RuntimeDlls = @('libgcc_s_seh-1.dll', 'libstdc++-6.dll', 'libwinpthread-1.dll', 'D3Dcompiler_47.dll')
            # Import-library suffix generated by the FFmpeg trim toolchain.
            ImportLibSuffix = '.dll.a'
            # MSVC redistributable subdirectory; unused by MinGW.
            MsvcRedistArch = ''
        }
        msvc = @{
            Arch        = 'x64'
            AqtArch     = 'win64_msvc2022_64'
            ArchDir     = 'msvc2022_64'
            QtHostPlatform = 'windows_x86'
            # '' => resolve the newest installed Visual Studio through vswhere.
            Generator   = ''
            GeneratorPlatform = ''
            BuildType   = 'Release'
            CompilerRoot = ''
            CCompiler   = ''
            CxxCompiler = ''
            RuntimeDlls = @('msvcp140.dll', 'vcruntime140.dll', 'vcruntime140_1.dll')
            ImportLibSuffix = '.lib'
            MsvcRedistArch = 'x64'
        }
        # Native Windows arm64 build host; the Qt repository keeps arm64
        # packages under its own host tree (windows_arm64), not the x86 one.
        'msvc-arm64' = @{
            Arch        = 'arm64'
            AqtArch     = 'win64_msvc2022_arm64'
            ArchDir     = 'msvc2022_arm64'
            QtHostPlatform = 'windows_arm64'
            Generator   = ''
            GeneratorPlatform = 'ARM64'
            BuildType   = 'Release'
            CompilerRoot = ''
            CCompiler   = ''
            CxxCompiler = ''
            RuntimeDlls = @('msvcp140.dll', 'vcruntime140.dll', 'vcruntime140_1.dll')
            ImportLibSuffix = '.lib'
            MsvcRedistArch = 'arm64'
        }
    }

    FFmpeg = @{
        # Shared dev SDK root (include/ + lib/ + bin/) relative to the repo root,
        # per target architecture. The .dll are gitignored; provision them with
        # scripts/ffmpeg/ensure-windows-ffmpeg-dev.ps1.
        DevDirByArch = @{
            x64   = 'third_party\ffmpeg\windows\win64\dev'
            arm64 = 'third_party\ffmpeg\windows\winarm64\dev'
        }
        # Directory holding the standalone export ffmpeg.exe, per architecture.
        ExportDirByArch = @{
            x64   = 'third_party\ffmpeg\windows\win64'
            arm64 = 'third_party\ffmpeg\windows\winarm64'
        }
        # Major-version-pinned runtime DLLs per architecture. x64 runs the
        # decode-only trim toolchain on the n7.1 series (allowlist pins
        # avcodec-61 in scripts/ffmpeg/trim/trim-allowlist.psd1); arm64 ships the
        # full BtbN n8.1 LGPL SDK untrimmed.
        RuntimeDllsByArch = @{
            x64 = @(
                'avcodec-61.dll', 'avformat-61.dll', 'avutil-59.dll',
                'swresample-5.dll', 'swscale-8.dll', 'avfilter-10.dll'
            )
            arm64 = @(
                'avcodec-62.dll', 'avformat-62.dll', 'avutil-60.dll',
                'swresample-6.dll', 'swscale-9.dll', 'avfilter-11.dll'
            )
        }
        # Architectures the decode-only trim toolchain covers.
        TrimByArch = @{
            x64   = $true
            arm64 = $false
        }
        # Standalone export binary shipped under app\ffmpeg\.
        ExportBinary = 'ffmpeg.exe'
    }

    Bass = @{
        RuntimeDirByArch = @{
            x64   = 'third_party\bass\bin\win64'
            arm64 = 'third_party\bass\bin\winarm64'
        }
        # un4seen ships bass_aac for x86/x64 only.
        RuntimeDllsByArch = @{
            x64   = @('bass.dll', 'bassmix.dll', 'bass_fx.dll', 'bass_aac.dll', 'bassopus.dll')
            arm64 = @('bass.dll', 'bassmix.dll', 'bass_fx.dll', 'bassopus.dll')
        }
    }

    Package = @{
        DistNameByArch = @{
            x64   = 'MiaCode-v{version}-win64'
            arm64 = 'MiaCode-v{version}-winarm64'
        }
        # Archives produced next to the package directory. 7z (LZMA2, solid)
        # compresses this payload to roughly half of what deflate achieves.
        ArchiveFormats = @('7z')
        # Required Qt runtime DLLs. 'qt:<BaseName>' entries get the Debug 'd'
        # suffix appended by the packaging script.
        QtRuntimeDllBaseNames = @(
            'Qt6Core', 'Qt6Gui', 'Qt6Multimedia',
            'Qt6Network', 'Qt6OpenGL', 'Qt6Quick', 'Qt6Qml', 'Qt6QmlMeta', 'Qt6QmlModels',
            'Qt6QmlWorkerScript', 'Qt6QuickControls2', 'Qt6Svg'
        )
        # Removed after deployment: the app does not link them.
        DeprecatedQtRuntimeDllBaseNames = @('Qt6OpenGLWidgets', 'Qt6Concurrent')
        # Removed after deployment: the app pins QQuickStyle::setStyle("Basic")
        # (src/app/main.cpp) and its QML imports only QtQuick.Controls /
        # QtQuick.Controls.impl, so the other Controls styles are dead weight.
        # Qt6Quick3DUtils is imported only by the qmltooling Quick3D profiler,
        # and FolderListModel is unused by the QML tree.
        UnusedQtRuntimeDllBaseNames = @(
            'Qt6QuickControls2Fusion', 'Qt6QuickControls2Imagine',
            'Qt6QuickControls2Material', 'Qt6QuickControls2Universal',
            'Qt6QuickControls2FusionStyleImpl', 'Qt6QuickControls2ImagineStyleImpl',
            'Qt6QuickControls2MaterialStyleImpl', 'Qt6QuickControls2UniversalStyleImpl',
            'Qt6QuickControls2FluentWinUI3StyleImpl', 'Qt6QuickControls2WindowsStyleImpl',
            'Qt6Quick3DUtils', 'Qt6LabsFolderListModel',
            # Qt6Widgets is a dev-tools-only dependency (see CMakeLists.txt); no
            # packaged PE imports it, so shipping it was 6.9 MB of dead weight.
            'Qt6Widgets'
        )
        UnusedQmlRelativePaths = @(
            'qml\QtQuick\Controls\FluentWinUI3',
            'qml\QtQuick\Controls\Fusion',
            'qml\QtQuick\Controls\Imagine',
            'qml\QtQuick\Controls\Material',
            'qml\QtQuick\Controls\Universal',
            'qml\QtQuick\Controls\Windows',
            'qml\Qt\labs\folderlistmodel',
            'qmltooling'
        )
        # Also removed from app\ after deployment.
        RemovedAppFiles = @('opengl32sw.dll')
        # assets\ subtrees that are embedded in MiaCode.exe via qrc and must not
        # be shipped loose as well.
        RedundantAssetPaths = @('reference', 'fonts')
        # SFX files the runtime reads from assets\SFX\.
        RequiredSfxFiles = @(
            'answer.wav', 'break_tap.wav', 'slide.wav', 'break.wav', 'break_slide.wav',
            'slide_break_start.wav', 'slide_break_slide.wav', 'tap_ex.wav', 'tap_perfect.wav',
            'touch_hanabi.wav', 'touch.wav', 'touch_Hold_riser.wav', 'clock.wav'
        )
        ReleaseDocs = @('LICENSE', 'LICENSE_SCOPE.md', 'THIRD_PARTY_NOTICES.md')
        # Required entries. 'qt:<BaseName>' expands to app\<BaseName>[d].dll;
        # 'toolchain-runtime:<DllName>' expands to app\<DllName> and is only
        # required for the toolchain that ships that runtime.
        RequiredRelativePaths = @(
            'MiaCode.exe',
            'Start_MiaCode_Debug.bat',
            'logs',
            'logs\worker-hwnd',
            'assets\SFX',
            'licenses\Resource-Han-Rounded-OFL.txt',
            'LICENSE',
            'LICENSE_SCOPE.md',
            'THIRD_PARTY_NOTICES.md',
            'app\MiaCode.exe',
            'app\ffmpeg\ffmpeg.exe',
            'app-qt:Qt6Core', 'app-qt:Qt6Gui', 'app-qt:Qt6Multimedia',
            'app-qt:Qt6Network', 'app-qt:Qt6OpenGL', 'app-qt:Qt6Quick', 'app-qt:Qt6Qml',
            'app-qt:Qt6QmlMeta', 'app-qt:Qt6QmlModels', 'app-qt:Qt6QmlWorkerScript',
            'app-qt:Qt6QuickControls2', 'app-qt:Qt6Svg',
            'app\bass.dll', 'app\bassmix.dll', 'app\bass_fx.dll',
            'app\bassopus.dll',
            'app\platforms\qwindows.dll',
            'app\qml\QtQuick\qtquick2plugin.dll',
            'app\qml\QtQuick\Controls\qtquickcontrols2plugin.dll',
            'app\qml\QtQuick\Layouts\qquicklayoutsplugin.dll',
            'app\qml\QtQml\Models\modelsplugin.dll',
            'app\qml\QtQml\WorkerScript\workerscriptplugin.dll'
        )
        # Paths that must NOT exist in the package.
        ForbiddenRelativePaths = @(
            'docs',
            'README.md',
            'README_EN.md',
            'RELEASE_README.txt',
            'Start_MiaCode_Debug_CompareDump.bat',
            'Start_MiaCode_Debug_View.bat',
            'Start_MiaCode_Debug_Widget.bat',
            'Start_MiaCode_QuickShell_Debug.bat',
            'app\extensions',
            'extensions',
            'Start_MiaCode_Legacy_QML.bat',
            'Start_MiaCode_SkipDiagD3D11.bat',
            'Start_MiaCode_DiagBypass.bat',
            'Start_MiaCode_SkipBoth.bat',
            'Start_MiaCode_QtPluginDiag.bat',
            'Start_MiaCode_DisablePerPixelAlpha.bat',
            'Start_MiaCode_ExportNoPboReadback.bat',
            'Start_MiaCode_WaveformAlignment_Test7.bat',
            'test_charts',
            'test_charts\7',
            'logs\quick-shell-beta',
            'qt:Qt6Core', 'qt:Qt6Gui',
            'bass.dll',
            'bassmix.dll',
            'D3Dcompiler_47.dll',
            'dxcompiler.dll',
            'ffmpeg\ffmpeg.exe',
            'libmpv-2.dll',
            'soundtouch_probe.exe',
            'app-qt:Qt6OpenGLWidgets',
            'app-qt:Qt6Concurrent',
            'app-qt:Qt6Widgets',
            'app\opengl32sw.dll',
            'app-qt:Qt6QuickControls2Imagine',
            'app-qt:Qt6QuickControls2Material',
            'app-qt:Qt6QuickControls2Universal',
            'app-qt:Qt6QuickControls2Fusion',
            'app-qt:Qt6Quick3DUtils',
            'app-qt:Qt6LabsFolderListModel',
            'app\qmltooling',
            'app\qml\QtQuick\Controls\FluentWinUI3',
            'app\qml\QtQuick\Controls\Fusion',
            'app\qml\QtQuick\Controls\Imagine',
            'app\qml\QtQuick\Controls\Material',
            'app\qml\QtQuick\Controls\Universal',
            'app\qml\QtQuick\Controls\Windows'
        )
        # Extra required entries beyond RequiredRelativePaths, per target
        # architecture: the architecture's FFmpeg runtime majors, plus bass_aac
        # (x86/x64 only upstream).
        AdditionalRequiredRelativePathsByArch = @{
            x64 = @(
                'app\bass_aac.dll',
                'app\avcodec-61.dll', 'app\avformat-61.dll', 'app\avutil-59.dll',
                'app\swresample-5.dll', 'app\swscale-8.dll', 'app\avfilter-10.dll'
            )
            arm64 = @(
                'app\avcodec-62.dll', 'app\avformat-62.dll', 'app\avutil-60.dll',
                'app\swresample-6.dll', 'app\swscale-9.dll', 'app\avfilter-11.dll'
            )
        }
    }

    # Windows system DLLs. Everything else an import table names must resolve
    # inside the package (verify-win-package.ps1).
    SystemDlls = @(
        'kernel32.dll', 'user32.dll', 'gdi32.dll', 'advapi32.dll', 'shell32.dll',
        'ole32.dll', 'oleaut32.dll', 'uuid.dll', 'comdlg32.dll', 'winspool.drv',
        'msvcrt.dll', 'ntdll.dll', 'ws2_32.dll', 'winmm.dll', 'version.dll',
        'dwmapi.dll', 'd3d11.dll', 'dxgi.dll', 'opengl32.dll', 'avrt.dll',
        'rstrtmgr.dll', 'setupapi.dll', 'userenv.dll', 'bcrypt.dll', 'crypt32.dll',
        'iphlpapi.dll', 'secur32.dll', 'shlwapi.dll', 'uxtheme.dll', 'comctl32.dll',
        'gdiplus.dll', 'imm32.dll', 'msimg32.dll', 'oleacc.dll', 'psapi.dll',
        'winhttp.dll', 'wininet.dll', 'wtsapi32.dll', 'dnsapi.dll', 'mpr.dll',
        'netapi32.dll', 'powrprof.dll', 'propsys.dll', 'rpcrt4.dll', 'sspicli.dll',
        'wldap32.dll', 'cfgmgr32.dll', 'd3d12.dll', 'dcomp.dll', 'directml.dll',
        'mf.dll', 'mfplat.dll', 'mfreadwrite.dll', 'mfuuid.dll', 'ncrypt.dll',
        'normaliz.dll', 'pdh.dll', 'sechost.dll', 'usp10.dll', 'wer.dll',
        'windowscodecs.dll', 'wintrust.dll', 'authz.dll', 'dwrite.dll',
        'msacm32.dll', 'avicap32.dll', 'evr.dll', 'd3d9.dll', 'dxva2.dll',
        'shcore.dll', 'd2d1.dll', 'd3d10warp.dll', 'hid.dll', 'ksuser.dll',
        'msdmo.dll', 'strmiids.dll', 'wbemuuid.dll', 'winusb.dll',
        # Windows 10 1703+ ships ICU and UI Automation as OS components; Qt 6.11
        # MSVC builds import them (Qt6Core -> icuuc.dll, qwindows -> UIAutomationCore).
        'icu.dll', 'icuuc.dll', 'icuin.dll', 'icudt.dll', 'uiautomationcore.dll',
        'd3dcompiler_47.dll',
        # Windows 10 1809+ system component used by process-wide PRNG seeding;
        # the BtbN FFmpeg n8.1 DLLs and its static ffmpeg.exe import it.
        'bcryptprimitives.dll'
    )
}
