{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-qt6",
      "displayName": "VS2022 + Qt6",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "ninja-mingw-qt6",
      "displayName": "Ninja + MinGW + Qt6",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "vs2022-qt6",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "vs2022-qt6",
      "configuration": "Debug"
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "configurePreset": "ninja-mingw-qt6",
      "jobs": 8
    }
  ]
}
