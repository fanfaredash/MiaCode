{
  "schema": 1,
  "notes": [
    "Action and shortcut entries are read by the app.",
    "Users may copy this file next to MiaCode.exe as shortcuts.json and override action/shortcut sequences without rebuilding."
  ],
  "actions": {
    "transform.mirror_lr": {
      "label_zh": "左右镜像",
