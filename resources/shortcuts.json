      "owner": "MainWindow.BootstrapAndMenus"
    },
    "transform.mirror_ud": {
      "label_zh": "上下镜像",
      "label_en": "Mirror Up/Down",
      "default": "Ctrl+K",
      "context": "application",
      "owner": "MainWindow.BootstrapAndMenus"
    },
    "transform.rotate_180": {
      "label_zh": "旋转 180°",
      "label_en": "Rotate 180",
      "default": "Ctrl+L",
      "context": "application",
      "owner": "MainWindow.BootstrapAndMenus"
    },
    "transform.rotate_ccw_45": {
      "label_zh": "逆时针旋转 45°",
      "label_en": "Rotate -45",
      "default": "Ctrl+;",
      "context": "application",
      "owner": "MainWindow.BootstrapAndMenus"
