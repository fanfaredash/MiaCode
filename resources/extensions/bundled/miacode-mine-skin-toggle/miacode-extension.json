{
  "id": "miacode-mine-skin-toggle",
  "name": "地雷皮肤切换",
  "version": "1.0.0",
  "publisher": "miacode",
  "engines": {
    "miacode": ">=1.0.0"
  },
  "main": "./main.js",
  "permissions": [
    "commands.execute",
    "preview.control",
    "preview.read",
    "settings.read",
    "settings.write",
    "ui.message"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "miacode-mine-skin-toggle.toggle",
        "title": "切换地雷皮肤",
        "category": "预览"
      },
      {
        "command": "miacode-mine-skin-toggle.toggle-sfx",
        "title": "切换地雷音效",
        "category": "预览"
      }
    ],
    "menus": {
      "tools/menu": [
        {
          "command": "miacode-mine-skin-toggle.toggle"
        },
        {
          "command": "miacode-mine-skin-toggle.toggle-sfx"
        }
      ]
    }
  }
}
