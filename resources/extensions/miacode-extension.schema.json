{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miacode.local/schemas/miacode-extension.schema.json",
  "title": "MiaCode Extension Manifest",
  "type": "object",
  "required": ["id", "name", "version", "publisher", "engines"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "main": { "type": "string", "minLength": 1 },
    "engines": {
      "type": "object",
      "required": ["miacode"],
      "properties": {
        "miacode": { "type": "string", "minLength": 1 }
      }
    },
    "activationEvents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command", "title"],
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
              },
              "title": { "type": "string", "minLength": 1 },
              "category": { "type": "string" }
            }
          }
        },
        "menus": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["command"],
              "properties": {
                "command": { "type": "string" }
              }
            }
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "translations"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
              },
              "label": { "type": "string", "minLength": 1 },
              "translations": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
